      "rows": [
        {"bet_option": 0, "user_discord_id": 1001, "bet_money_amount": 50},
        {"bet_option": 0, "user_discord_id": 1002, "bet_money_amount": 30}
      ],
      "expected": {"action": "refund", "koef": null, "outcome": {"A": {"1001": 50, "1002": 30}, "B": {}}}
    },

    "refund_no_bets_on_winner": {
      "opts": ["A", "B", "C"], "choice": "C",
      "rows": [
        {"bet_option": 0, "user_discord_id": 1001, "bet_money_amount": 10},
