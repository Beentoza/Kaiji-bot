{
  "_note": "Pure calculate_payouts(rows, opts, choice): winners/losers, payout = {winner discord_id: stake + stake * loser_sum // win_sum} worked out by hand, or refund (when <2 active options OR no bets on the winner OR no losers). No DB.",

  "scenarios": {
    "payout_even": {
      "opts": ["A", "B"], "choice": "A",
      "rows": [
        {"bet_option": 0, "user_discord_id": 1001, "bet_money_amount": 50},
        {"bet_option": 1, "user_discord_id": 1002, "bet_money_amount": 30},
        {"bet_option": 1, "user_discord_id": 1003, "bet_money_amount": 20}
      ],
      "expected": {"action": "payout", "payout": {"1001": 100}, "outcome": {"A": {"1001": 50}, "B": {"1002": 30, "1003": 20}}}
    },

    "payout_uneven": {
      "opts": ["A", "B"], "choice": "A",
      "rows": [
        {"bet_option": 0, "user_discord_id": 1001, "bet_money_amount": 20},
        {"bet_option": 1, "user_discord_id": 1002, "bet_money_amount": 60}
      ],
      "expected": {"action": "payout", "payout": {"1001": 80}, "outcome": {"A": {"1001": 20}, "B": {"1002": 60}}}
    },

    "payout_three_options": {
      "opts": ["A", "B", "C"], "choice": "B",
      "rows": [
        {"bet_option": 0, "user_discord_id": 1001, "bet_money_amount": 10},
        {"bet_option": 1, "user_discord_id": 1002, "bet_money_amount": 40},
        {"bet_option": 2, "user_discord_id": 1003, "bet_money_amount": 50}
      ],
      "expected": {"action": "payout", "payout": {"1002": 100}, "outcome": {"A": {"1001": 10}, "B": {"1002": 40}, "C": {"1003": 50}}}
    },

    "_payout_remainder": "loser_sum < win_sum and // leaves a remainder: 50*90/80 = 56.25, 30*90/80 = 33.75. 89 of 90 paid out, 1 stays in the bank. dividing the sums first (90 // 80 = 1) would give 100 and 60",
    "payout_remainder": {
      "opts": ["A", "B"], "choice": "A",
      "rows": [
        {"bet_option": 0, "user_discord_id": 1001, "bet_money_amount": 50},
        {"bet_option": 0, "user_discord_id": 1002, "bet_money_amount": 30},
        {"bet_option": 1, "user_discord_id": 1003, "bet_money_amount": 90}
      ],
      "expected": {"action": "payout", "payout": {"1001": 106, "1002": 63}, "outcome": {"A": {"1001": 50, "1002": 30}, "B": {"1003": 90}}}
    },

    "_payout_tiny_loser_sum": "49 * (1/49) is 0.9999999999999999 in float, int() makes it 0. the exact answer is 49 + 1",
    "payout_tiny_loser_sum": {
      "opts": ["A", "B"], "choice": "A",
      "rows": [
        {"bet_option": 0, "user_discord_id": 1001, "bet_money_amount": 49},
        {"bet_option": 1, "user_discord_id": 1002, "bet_money_amount": 1}
      ],
      "expected": {"action": "payout", "payout": {"1001": 50}, "outcome": {"A": {"1001": 49}, "B": {"1002": 1}}}
    },

    "refund_single_option": {
      "opts": ["A", "B"], "choice": "A",
      "rows": [
        {"bet_option": 0, "user_discord_id": 1001, "bet_money_amount": 50},
        {"bet_option": 0, "user_discord_id": 1002, "bet_money_amount": 30}
      ],
      "expected": {"action": "refund", "outcome": {"A": {"1001": 50, "1002": 30}, "B": {}}}
    },

    "refund_no_bets_on_winner": {
      "opts": ["A", "B", "C"], "choice": "C",
      "rows": [
        {"bet_option": 0, "user_discord_id": 1001, "bet_money_amount": 10},
        {"bet_option": 1, "user_discord_id": 1002, "bet_money_amount": 20}
      ],
      "expected": {"action": "refund", "outcome": {"A": {"1001": 10}, "B": {"1002": 20}, "C": {}}}
    },

    "refund_no_participants": {
      "opts": ["A", "B"], "choice": "A",
      "rows": [],
      "expected": {"action": "refund", "outcome": {"A": {}, "B": {}}}
    }
  }
}
